# IMPORTANT: Choose ONE configuration based on how you're accessing the app

# ============================================
# OPTION 1: LOCALHOST ACCESS (Desktop Only)
# ============================================
# Use this when:
# - Accessing from http://localhost:5173 on your laptop
# - Sessions will work perfectly
# - Mobile access will NOT work

# VITE_API_URL=http://localhost:5000/api

# ============================================
# OPTION 2: NETWORK ACCESS (Desktop + Mobile)
# ============================================
# Use this when:
# - Accessing from http://192.168.1.77:5173 on ANY device
# - Both laptop and mobile can access
# - Sessions will work on both devices
# - MUST access from network IP on laptop too (not localhost)

VITE_API_URL=http://192.168.1.77:5000/api

# ============================================
# App Configuration
# ============================================
VITE_APP_NAME=Daily Blogs
VITE_APP_VERSION=1.0.0

# ============================================
# HOW TO SWITCH:
# ============================================
# 1. Uncomment the VITE_API_URL you want to use
# 2. Comment out the other one
# 3. Restart frontend: npm run dev
# 4. Clear browser cookies
# 5. Use matching URL to access:
#    - Option 1: http://localhost:5173
#    - Option 2: http://192.168.1.77:5173
